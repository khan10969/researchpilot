QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=researchpilot_chunks_v1

# Streamlit 在宿主机运行时访问 FastAPI 的地址。
# Docker Compose 会将其覆盖为 http://api:8000。
WEB_API_BASE_URL=http://127.0.0.1:8000

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=4

# 可选：自定义 Hugging Face 模型缓存目录
# HF_HOME=D:/AIModels/huggingface

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.0
LLM_STRUCTURED_MAX_ATTEMPTS=2

RAG_TOP_K=6
RAG_MAX_OUTPUT_TOKENS=1600
RAG_TABLE_TOP_K_PER_DOCUMENT=2
RAG_MULTI_QUERY_CANDIDATE_K=6
RAG_RRF_K=60
RAG_QUERY_DIVERSITY_K_PER_DOCUMENT=2

RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512

ANALYSIS_MODEL=deepseek-v4-flash
ANALYSIS_TOP_K_PER_DOCUMENT=8
ANALYSIS_MAX_TABLES_PER_DOCUMENT=8
ANALYSIS_MAX_OUTPUT_TOKENS=5000

EVAL_JUDGE_MODEL=deepseek-v4-flash
EVAL_JUDGE_MAX_OUTPUT_TOKENS=2400
EVAL_JUDGE_TEMPERATURE=0.0

MAX_UPLOAD_SIZE_MB=50